{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XP Enhance",
  "version": "0.2.0",
  "identifier": "com.xpenhance.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XP Enhance",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "X-Plane 12 visual enhancement manager",
    "longDescription": "Configure visual enhancement presets and manage X-Plane 12 settings."
  }
}