{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XP Enhance",
  "version": "0.6.1",
  "identifier": "com.xpenhance.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XP Enhance",
        "width": 1480,
        "height": 960,
        "minWidth": 960,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Graphite glass flight environment workspace for X-Plane 12",
    "longDescription": "A local-first X-Plane 12 visual profile and performance workspace."
  }
}
