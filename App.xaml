<Application x:Class="XPEnhance.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Color x:Key="Bg">#101318</Color><Color x:Key="Panel">#191E26</Color><Color x:Key="Accent">#58A6FF</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Bg}"/><SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F4F8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#F1F4F8"/><Setter Property="Background" Value="#202733"/><Setter Property="BorderBrush" Value="#354252"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,4,6,4"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F1F4F8"/><Setter Property="Margin" Value="0,4"/></Style>
  </Application.Resources>
</Application>